      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "influxdb", "uid": "influxdb-evcc"},
          "query": "import \"timezone\"\n\noption location = timezone.location(name: \"{{ server_timezone }}\")\n\nfrom(bucket: \"{{ influxdb_evcc_bucket_name }}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"pvEnergy\" and r._field == \"value\" and not exists r.id)\n  |> aggregateWindow(every: 1d, fn: max, timeSrc: \"_start\", createEmpty: false)\n  |> difference(nonNegative: true)"
