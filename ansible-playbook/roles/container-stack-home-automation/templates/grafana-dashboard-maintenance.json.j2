      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-home-assistant"
          },
          "query": "import \"strings\"\n\nclean = (n) => {\n    a = strings.trimSuffix(v: n, suffix: \" Battery\")\n    b = strings.trimSuffix(v: a, suffix: \" Battery Level\")\n    c = strings.trimSuffix(v: b, suffix: \" Battery level\")\n    d = strings.trimSuffix(v: c, suffix: \"_battery\")\n    return strings.title(v: strings.replaceAll(v: d, t: \"_\", u: \" \"))\n}\n\nnames = from(bucket: \"{{ influxdb_bucket_name }}\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"%\" and r._field == \"friendly_name_str\")\n  |> last()\n  |> keep(columns: [\"entity_id\", \"_value\"])\n  |> group()\n  |> map(fn: (r) => ({entity_id: r.entity_id, device: clean(n: r._value)}))\n\nlevels = from(bucket: \"{{ influxdb_bucket_name }}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"%\" and r._field == \"value\" and (r.entity_id =~ /_battery$/ or r.entity_id =~ /_battery_level$/))\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n\njoin(tables: {l: levels, n: names}, on: [\"entity_id\"])\n  |> group(columns: [\"device\"])\n  |> keep(columns: [\"_time\", \"_value\", \"device\"])"
        }
