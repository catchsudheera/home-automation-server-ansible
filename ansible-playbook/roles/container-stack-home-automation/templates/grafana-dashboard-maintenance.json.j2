      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-home-assistant"
          },
          "query": "import \"strings\"\n\nseconds = from(bucket: \"{{ influxdb_bucket_name }}\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"s\" and r._field == \"value\" and r.entity_id =~ /^roborock_.*_time_left$/)\n  |> last()\n\nhours = from(bucket: \"{{ influxdb_bucket_name }}\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"h\" and r._field == \"value\" and r.entity_id =~ /^roborock_.*_time_left$/)\n  |> last()\n  |> map(fn: (r) => ({r with _value: r._value * 3600.0}))\n\nunion(tables: [seconds, hours])\n  |> group()\n  |> map(fn: (r) => ({Part: strings.title(v: strings.replaceAll(v: strings.trimSuffix(v: strings.trimPrefix(v: r.entity_id, prefix: \"roborock_s7_maxv_\"), suffix: \"_time_left\"), t: \"_\", u: \" \")), Remaining: r._value}))\n  |> sort(columns: [\"Remaining\"])"
        }
