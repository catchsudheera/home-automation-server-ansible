        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-home-assistant"
          },
          "query": "import \"strings\"\n\nclean = (n) => {\n    a = strings.trimSuffix(v: n, suffix: \" Battery\")\n    b = strings.trimSuffix(v: a, suffix: \" Battery Level\")\n    c = strings.trimSuffix(v: b, suffix: \" Battery level\")\n    d = strings.trimSuffix(v: c, suffix: \"_battery\")\n    return strings.title(v: strings.replaceAll(v: d, t: \"_\", u: \" \"))\n}\n\nnames = from(bucket: \"{{ influxdb_bucket_name }}\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"%\" and r._field == \"friendly_name_str\")\n  |> last()\n  |> keep(columns: [\"entity_id\", \"_value\"])\n  |> group()\n  |> map(fn: (r) => ({entity_id: r.entity_id, device: clean(n: r._value)}))\n\nbase = from(bucket: \"{{ influxdb_bucket_name }}\")\n  |> range(start: -21d)\n  |> filter(fn: (r) => r._measurement == \"%\" and r._field == \"value\" and (r.entity_id =~ /_battery$/ or r.entity_id =~ /_battery_level$/) and r.entity_id !~ /(iphone|ipad|watch|sm_x200|roborock)/)\n  |> aggregateWindow(every: 1d, fn: last, createEmpty: false)\n\ncurrent = base\n  |> last()\n  |> group()\n  |> keep(columns: [\"entity_id\", \"_value\"])\n  |> rename(columns: {_value: \"level\"})\n\nrate = base\n  |> difference()\n  |> mean()\n  |> group()\n  |> keep(columns: [\"entity_id\", \"_value\"])\n  |> rename(columns: {_value: \"perday\"})\n\nstats = join(tables: {c: current, r: rate}, on: [\"entity_id\"])\n\njoin(tables: {s: stats, n: names}, on: [\"entity_id\"])\n  |> filter(fn: (r) => r.perday < 0.0)\n  |> map(fn: (r) => ({Device: r.device, Level: r.level, Days: r.level / (-1.0 * r.perday)}))\n  |> sort(columns: [\"Days\"])"
        }
      ]
