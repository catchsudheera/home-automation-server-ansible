        "type": "influxdb",
        "uid": "influxdb-home-assistant"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "auto",
            "pointSize": 4,
            "axisPlacement": "auto",
            "gradientMode": "opacity",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "decimals": 0,
          "displayName": "${__field.labels.inverter}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-home-assistant"
          },
          "query": "import \"strings\"\n\nfrom(bucket: \"{{ influxdb_bucket_name }}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"W\" and r._field == \"value\" and r.entity_id =~ /^inverter_/)\n  |> map(fn: (r) => ({r with inverter: strings.trimPrefix(v: r.entity_id, prefix: \"inverter_\")}))\n  |> group(columns: [\"inverter\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Panel Ranking",
      "description": "Energy and peak output per panel over the selected range. Energy is the integral of reported power, so it is an estimate rather than a meter reading - compare panels against each other, not against the Envoy total.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-home-assistant"
      },
      "gridPos": {
        "h": 13,
        "w": 10,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Energy"
            },
            "properties": [
              {
                "id": "unit",
                "value": "watth"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "min",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Peak"
            },
            "properties": [
              {
                "id": "unit",
                "value": "watt"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-home-assistant"
          },
          "query": "import \"strings\"\n\nbase = from(bucket: \"{{ influxdb_bucket_name }}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"W\" and r._field == \"value\" and r.entity_id =~ /^inverter_/)\n\nenergy = base\n  |> integral(unit: 1h)\n  |> group()\n  |> keep(columns: [\"entity_id\", \"_value\"])\n  |> rename(columns: {_value: \"energy\"})\n\npeak = base\n  |> max()\n  |> group()\n  |> keep(columns: [\"entity_id\", \"_value\"])\n  |> rename(columns: {_value: \"peak\"})\n\njoin(tables: {e: energy, p: peak}, on: [\"entity_id\"])\n  |> map(fn: (r) => ({Panel: strings.trimPrefix(v: r.entity_id, prefix: \"inverter_\"), Energy: r.energy, Peak: r.peak}))\n  |> sort(columns: [\"Energy\"], desc: true)"
        }
      ]
    },
