    {
      "id": 7,
      "type": "stat",
      "title": "Inverters Reporting",
      "description": "Micro-inverters that sent a reading in the last 30 minutes. They stop reporting after dark, so this only means something in daylight.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-home-assistant"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-home-assistant"
          },
          "query": "import \"array\"\n\nreporting = from(bucket: \"{{ influxdb_bucket_name }}\")\n  |> range(start: -30m)\n  |> filter(fn: (r) => r._measurement == \"W\" and r._field == \"value\" and r.entity_id =~ /^inverter_/)\n  |> last()\n  |> group()\n  |> count()\n\n// After dark the inverters stop reporting entirely, which would leave the\n// panel showing \"No data\" rather than the zero that is actually true.\nunion(tables: [reporting, array.from(rows: [{_value: 0}])])\n  |> sum()"
        }
      ]
    },
