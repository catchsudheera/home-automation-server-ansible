          },
          "query": "import \"strings\"\n\nlabel = (id) => strings.title(v: strings.replaceAll(v: id, t: \"_\", u: \" \"))\n\ntemperature = from(bucket: \"{{ influxdb_bucket_name }}\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"°C\" and r._field == \"value\" and r.entity_id =~ /^th_sensor_/ and r.entity_id !~ /drybox/)\n  |> last()\n  |> group()\n  |> map(fn: (r) => ({room: label(id: strings.trimSuffix(v: strings.trimPrefix(v: r.entity_id, prefix: \"th_sensor_\"), suffix: \"_temperature\")), temperature: r._value}))\n\nhumidity = from(bucket: \"{{ influxdb_bucket_name }}\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"%\" and r._field == \"value\" and r.entity_id =~ /^th_sensor_/ and r.entity_id !~ /drybox/ and r.entity_id =~ /_humidity$/)\n  |> last()\n  |> group()\n  |> map(fn: (r) => ({room: label(id: strings.trimSuffix(v: strings.trimPrefix(v: r.entity_id, prefix: \"th_sensor_\"), suffix: \"_humidity\")), humidity: r._value}))\n\njoin(tables: {t: temperature, h: humidity}, on: [\"room\"])\n  |> sort(columns: [\"room\"])"
