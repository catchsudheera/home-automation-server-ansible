    {
      "id": 11,
      "type": "timeseries",
      "title": "Power by Appliance",
      "description": "Series are named from the Home Assistant friendly name, not the entity_id - several entity_ids no longer match what is plugged in.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-home-assistant"
      },
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "auto",
            "pointSize": 4,
            "axisPlacement": "auto",
            "gradientMode": "opacity",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "decimals": 0,
          "displayName": "${__field.labels.appliance}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-home-assistant"
          },
          "query": "import \"strings\"\n\nclean = (n) => {\n    a = strings.trimSuffix(v: n, suffix: \" power\")\n    b = strings.trimSuffix(v: a, suffix: \" Power\")\n    c = strings.trimSuffix(v: b, suffix: \" energy\")\n    d = strings.trimSuffix(v: c, suffix: \" Energy\")\n    e = strings.trimSuffix(v: d, suffix: \" Switch 0\")\n    f = strings.trimPrefix(v: e, prefix: \"shelly_plug_\")\n    return strings.title(v: strings.replaceAll(v: f, t: \"_\", u: \" \"))\n}\n\nnames = from(bucket: \"{{ influxdb_bucket_name }}\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"W\" and r._field == \"friendly_name_str\")\n  |> last()\n  |> keep(columns: [\"entity_id\", \"_value\"])\n  |> group()\n  |> map(fn: (r) => ({entity_id: r.entity_id, appliance: clean(n: r._value)}))\n\npower = from(bucket: \"{{ influxdb_bucket_name }}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"W\" and r._field == \"value\" and r.entity_id !~ /^inverter_/ and r.entity_id !~ /^(washer_samsung|dryer)_/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n\njoin(tables: {d: power, n: names}, on: [\"entity_id\"])\n  |> group(columns: [\"appliance\"])\n  |> keep(columns: [\"_time\", \"_value\", \"appliance\"])"
        }
      ]
    },
