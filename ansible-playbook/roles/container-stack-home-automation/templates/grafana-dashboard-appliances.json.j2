          "query": "import \"strings\"\n\nclean = (n) => {\n    a = strings.trimSuffix(v: n, suffix: \" power\")\n    b = strings.trimSuffix(v: a, suffix: \" Power\")\n    c = strings.trimSuffix(v: b, suffix: \" energy\")\n    d = strings.trimSuffix(v: c, suffix: \" Energy\")\n    e = strings.trimSuffix(v: d, suffix: \" Switch 0\")\n    f = strings.trimPrefix(v: e, prefix: \"shelly_plug_\")\n    return strings.title(v: strings.replaceAll(v: f, t: \"_\", u: \" \"))\n}\n\nnames = from(bucket: \"{{ influxdb_bucket_name }}\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"W\" and r._field == \"friendly_name_str\")\n  |> last()\n  |> keep(columns: [\"entity_id\", \"_value\"])\n  |> group()\n  |> map(fn: (r) => ({entity_id: r.entity_id, appliance: clean(n: r._value)}))\n\ncurrent = from(bucket: \"{{ influxdb_bucket_name }}\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"W\" and r._field == \"value\" and r.entity_id !~ /^inverter_/ and r.entity_id !~ /^(washer_samsung|dryer)_/)\n  |> last()\n  |> group()\n  |> keep(columns: [\"entity_id\", \"_value\"])\n\njoin(tables: {d: current, n: names}, on: [\"entity_id\"])\n  |> map(fn: (r) => ({Appliance: r.appliance, Watts: r._value}))\n  |> sort(columns: [\"Watts\"], desc: true)"
